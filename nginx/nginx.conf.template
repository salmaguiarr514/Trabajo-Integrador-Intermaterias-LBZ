# Balanceo de carga entre las réplicas de la API, una por PC.
# Sin otra directiva, nginx usa round robin: 1er pedido a la PC 1, 2do a la PC 2, 3ro a la PC 3, y vuelve a empezar.
# Las IPs vienen del .env de la PC de acceso. La imagen de nginx reemplaza ${...} al arrancar
# (solo variables de entorno: las variables propias de nginx, como $host, se dejan como están).

# Muestra en el log qué réplica atendió cada pedido
log_format balanceo '$remote_addr "$request" $status -> $upstream_addr';

upstream api_eventos {
    server ${IP_PC1}:3000 max_fails=3 fail_timeout=10s;
    server ${IP_PC2}:3000 max_fails=3 fail_timeout=10s;
    server ${IP_PC3}:3000 max_fails=3 fail_timeout=10s;
}

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log balanceo;

    # Front: el build de React (archivos estáticos)
    root  /usr/share/nginx/html;
    index index.html;

    # API: todo lo que empieza con /api/ se reparte entre las réplicas
    location /api/ {
        proxy_pass http://api_eventos;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Si una réplica se cae, reintenta el pedido en la siguiente
        proxy_next_upstream error timeout http_502 http_503;

        # Devuelve al navegador la IP:puerto del nodo que respondió
        add_header X-Upstream $upstream_addr always;
    }

    # React Router: cualquier ruta del front (/login, /empresa/eventos…) carga index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
