PORT=3000
FRONTEND_URL=http://localhost:5173

# Base compartida del grupo en Supabase (pedirla por privado). Session pooler.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Sin DATABASE_URL se usan estas (Postgres local o en Docker)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=backstage

# Clave para firmar los tokens de sesión. Cualquier texto largo y secreto;
# todas las réplicas de la API tienen que usar la misma.
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto
JWT_EXPIRA=8h

# Gmail para mandar el código de verificación del email (opcional).
# GMAIL_CLAVE_APP es una "contraseña de aplicación" de Google (16 letras), no la contraseña de la cuenta.
# Si no están, el mail no se manda y el código aparece en la consola de la API.
GMAIL_USUARIO=
GMAIL_CLAVE_APP=
# Solo para desarrollo: sin Gmail, guarda cada mail como .eml en esta carpeta para verlo
# CORREO_CARPETA=./correos

# Claves para firmar los QR de las entradas y los enlaces de verificación (opcionales: si no están, se usa JWT_SECRET).
# Si se cambia ENTRADAS_SECRET, los QR ya emitidos dejan de pasar el control (el código escrito a mano sigue sirviendo).
# ENTRADAS_SECRET=
# VERIFICACION_SECRET=

# Conexiones con la base por instancia de la API (en Vercel: 3, porque cada instancia abre las suyas)
# DB_POOL_MAX=3
