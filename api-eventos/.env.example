PORT=3000
FRONTEND_URL=http://localhost:5173

# Base compartida del grupo en Supabase (pedirla por privado). Session pooler.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Sin DATABASE_URL se usan estas (Postgres local o en Docker)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=backstage

# Clave para firmar los tokens de sesión. Cualquier texto largo y secreto;
# todas las réplicas de la API tienen que usar la misma.
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto
JWT_EXPIRA=8h
