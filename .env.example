# Variables para docker compose. Copiar a .env en la raíz del repo, en cada PC.
# El .env NO se commitea. JWT_SECRET tiene que ser IGUAL en las 3 PCs (un token firmado por una réplica lo valida otra).

# Base (solo la usa la PC de acceso, donde corre Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_contraseña
POSTGRES_DB=backstage

# API (las 3 PCs)
JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio
JWT_EXPIRA=8h
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# IPs de las 3 PCs en la red local (PC 1 = acceso: nginx + base + api1)
IP_PC1=192.168.0.10
IP_PC2=192.168.0.11
IP_PC3=192.168.0.12

# Nombre de esta réplica: api2 en la PC 2, api3 en la PC 3 (la PC de acceso es api1 y lo fija el compose)
INSTANCIA=api2
